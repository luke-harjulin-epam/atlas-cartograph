{
  "name": "atlas-cartograph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas knowledge-graph viewer as a GitHub Copilot canvas",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node .apm/extensions/cartograph/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:version": "node scripts/check-version.mjs",
    "pack:apm": "apm pack --format plugin",
    "pack:release": "node scripts/package-apm.mjs"
  }
}
